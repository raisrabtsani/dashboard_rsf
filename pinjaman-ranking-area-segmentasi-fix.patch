+    public function test_ranking_cabang_menyertakan_deskripsi_area_head(): void
+    {
+        $data = $this->actingAs($this->admin())
+            ->getJson('/api/pinjaman/branch-pencapaian?tanggal='.self::POSISI.'&tab=total')
+            ->assertOk()
+            ->json();
